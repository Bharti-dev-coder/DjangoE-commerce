# Copy this file to .env and fill in the values. Never commit .env.

# Django host/security settings
# Generate a production key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-random-production-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Separate multiple HTTPS origins with commas, for example:
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-domain.com
CSRF_TRUSTED_ORIGINS=

# Database
# Preferred hosted setup: set DATABASE_URL to a Postgres or MySQL connection
# string. Vercel/Neon Postgres integrations usually provide this automatically.
# Leave blank to use the local SQLite fallback.
DATABASE_URL=
DB_CONN_MAX_AGE=0

# Optional local/explicit database settings, used only when DATABASE_URL is blank.
# For MySQL use: DB_ENGINE=django.db.backends.mysql
# For SQLite use: DB_ENGINE=django.db.backends.sqlite3 and DB_NAME=db.sqlite3
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Existing email settings
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Storefront display and pricing
STORE_CURRENCY_CODE=INR
STORE_CURRENCY_SYMBOL=₹
STORE_FREE_SHIPPING_THRESHOLD=999.00
STORE_SHIPPING_CHARGE=49.00
STORE_TAX_RATE=0.00

# Razorpay test/live credentials
# RAZORPAY_KEY_ID is public and is rendered in the checkout page.
# RAZORPAY_KEY_SECRET must stay server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT=20

# Demo-only media serving. Leave false when product images use object storage.
# Vercel uses true for the bundled demo catalog images.
SERVE_MEDIA=false

# Local Ollama shopping assistant (optional)
# Set OLLAMA_ENABLED=false on Vercel unless a reachable Ollama endpoint exists.
# Product, cart, and order facts always come from the Django database.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=60
OLLAMA_NUM_CTX=3072
OLLAMA_MAX_PREDICT=220
AI_CHAT_HISTORY_LIMIT=8
AI_CHAT_MAX_MESSAGE_LENGTH=800
AI_RECOMMENDATION_LIMIT=4
AI_SEARCH_LIMIT=6
